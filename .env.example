# .env.example
# Copy this file to .env and fill in your values

# -------------------------------
# CORE DJANGO SETTINGS
# -------------------------------
# WARNING: keep the secret key used in production secret!
SECRET_KEY=replace_this_with_a_real_secret_key_in_your_local_env
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# -------------------------------
# CORS CONFIGURATION
# -------------------------------
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------------
# DATABASE (POSTGRES)
# -------------------------------
# For local development with docker-compose
POSTGRES_DB=intentlink
POSTGRES_USER=intentlink
POSTGRES_PASSWORD=a_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# For Render deployment (use DATABASE_URL instead)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# -------------------------------
# CACHE & QUEUE (REDIS)
# -------------------------------
REDIS_URL=redis://cache:6379/0

# -------------------------------
# EXTERNAL SERVICES & BLOCKCHAIN
# -------------------------------
DAGSCANNER_URL=https://dagscanner.example.com/api/v1/analyze/
IPFS_API_URL=https://ipfs.infura.io:5001

# BlockDAG "Awakening" Testnet Configuration
BLOCKDAG_RPC_URL=https://rpc.awakening.bdagscan.com
BLOCKDAG_CHAIN_ID=1043

# Polygon Amoy Testnet
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_CHAIN_ID=80002

# -------------------------------
# RELAYER CONFIGURATION
# -------------------------------
# IMPORTANT: DO NOT COMMIT THIS KEY TO GIT. This is for local development only.
# Use a secure secret manager in production.
RELAYER_PRIVATE_KEY=0x...your_test_private_key
RELAYER_ADDRESS=0x...your_test_wallet_address

# -------------------------------
# LLM & AI CONFIGURATION
# -------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
SENTRY_DSN=

# -------------------------------
# GOPLUS SECURITY API
# -------------------------------
GOPLUS_API_KEY=your_goplus_api_key
GOPLUS_API_SECRET=your_goplus_api_secret
GOPLUS_API_BASE=https://api.gopluslabs.io/api/v1

